<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="external_camera">
    <static>true</static>
    <!-- 
      Camera pose is defined per-world via <include><pose> in the world SDF.
      Intrinsics are kept consistent via world_profiles.yaml and the camera model.
    -->
    <pose>0 0 0 0 0 0</pose>
    <link name="link">
      <sensor name="camera" type="camera">
        <camera>
          <horizontal_fov>1.5708</horizontal_fov> <!-- 90 degrees -->
          <!-- 1280x720: segmentation camera (the real Gazebo bottleneck) is
               already disabled; reverting RGB to original resolution keeps
               the camera model (focal length) identical to F37, preserving
               the fast CasADi EFE compilation and the r_vis/r_miss ratio. -->
          <image>
            <width>1280</width>
            <height>720</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <topic>external_camera/image_raw</topic>
      </sensor>
      <!-- Segmentation camera: update_rate reduced from 30→1 Hz.
           The semantic render pass at 1280×720 is expensive and was the main
           Gazebo real-time bottleneck.  YOLO detects the robot from the plain
           RGB image; these topics are never consumed at runtime.
           Keeping the sensor at 1 Hz avoids breaking any debug tooling. -->
      <sensor name="segmentation_camera" type="segmentation">
        <camera>
          <segmentation_type>semantic</segmentation_type>
          <horizontal_fov>1.5708</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>1</update_rate>
        <visualize>false</visualize>
        <topic>external_camera/segmentation</topic>
      </sensor>
    </link>
  </model>
</sdf>
