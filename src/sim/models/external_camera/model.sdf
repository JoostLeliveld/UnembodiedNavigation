<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="external_camera">
    <static>true</static>
    <!-- 
      Camera Setup for 45° Oblique View (required for projective nonlinearity study)
      
      Position in odom frame: (-3, -3, 6)
      Position in Gazebo: (-3, -3, 6) since robot spawns at Gazebo (0,0)
      
      Orientation (looking at midpoint of path at odom (1.5, 1.5, 0)):
        - Yaw: 0.7854 rad (45°) = looking toward +X+Y diagonal
        - Pitch: -0.756 rad (-43.3°) = looking down ~45° from horizontal
        - Roll: 0
      
      Coverage verified:
        - Start (0,0): pixel (960, 734) - IN VIEW
        - Goal (3,3): pixel (960, 404) - IN VIEW  
        - Midpoint (1.5, 1.5): pixel (960, 540) - IN VIEW (center)
    -->
    <pose>-3 -3 6.0 0 -0.756 0.7854</pose>
    <link name="link">
      <visual name="visual">
        <geometry>
          <box>
            <size>0.1 0.1 0.1</size>
          </box>
        </geometry>
      </visual> 
      <sensor name="camera" type="camera">
        <camera>
          <horizontal_fov>1.5708</horizontal_fov> <!-- 90 degrees -->
          <image>
            <width>1920</width>
            <height>1080</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>external_camera/image_raw</topic>
      </sensor>
    </link>
  </model>
</sdf>
