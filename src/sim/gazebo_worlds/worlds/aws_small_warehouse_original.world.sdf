    <!-- Overhead camera — south-west corner looking north-east across the open
         corridor toward the shelf aisles.
         Bridges to /external_camera/image_raw via bringup_sim.launch.py. -->
    <include>
      <name>external_camera</name>
      <uri>model://external_camera</uri>
      <pose>6.5 10.0 6.0 0 0.41 -2.07</pose>
    </include>

  </world>
