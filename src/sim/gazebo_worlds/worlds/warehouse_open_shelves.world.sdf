      </link>

      <link name="mid_upright_sw">
        <pose>-2.37 -0.55 1.15 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.04</radius><length>2.30</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.04</radius><length>2.30</length></cylinder></geometry><material><ambient>0.18 0.18 0.18 1.0</ambient><diffuse>0.18 0.18 0.18 1.0</diffuse></material></visual>
      </link>
      <link name="mid_upright_se">
        <pose>-1.93 -0.55 1.15 0 0 0</pose>
