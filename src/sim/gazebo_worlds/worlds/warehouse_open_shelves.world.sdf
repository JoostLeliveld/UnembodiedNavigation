        <visual name="visual"><geometry><cylinder><radius>0.04</radius><length>2.00</length></cylinder></geometry><material><ambient>0.18 0.18 0.18 1.0</ambient><diffuse>0.18 0.18 0.18 1.0</diffuse></material></visual>
      </link>
      <link name="south_upright_se">
        <pose>-1.88 -2.55 1.00 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.04</radius><length>2.00</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.04</radius><length>2.00</length></cylinder></geometry><material><ambient>0.18 0.18 0.18 1.0</ambient><diffuse>0.18 0.18 0.18 1.0</diffuse></material></visual>
