      </link>
      <link name="north_upright_ne">
        <pose>-1.98 2.40 1.10 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.04</radius><length>2.20</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.04</radius><length>2.20</length></cylinder></geometry><material><ambient>0.18 0.18 0.18 1.0</ambient><diffuse>0.18 0.18 0.18 1.0</diffuse></material></visual>
      </link>
      <link name="north_stock_block">
        <pose>-2.20 1.75 0.55 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.36 1.20 1.10</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.36 1.20 1.10</size></box></geometry><material><ambient>0.62 0.51 0.34 1.0</ambient><diffuse>0.62 0.51 0.34 1.0</diffuse></material></visual>
      </link>
