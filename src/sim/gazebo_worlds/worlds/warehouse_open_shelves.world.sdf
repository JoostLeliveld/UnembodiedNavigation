      </link>
    </model>

    <include>
      <uri>model://external_camera</uri>
      <pose>-5.35 -5.20 3.05 0 0.56 0.7854</pose>
    </include>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1.0</intensity>
      <direction>-0.55 0.15 -0.82</direction>
    </light>

  </world>
