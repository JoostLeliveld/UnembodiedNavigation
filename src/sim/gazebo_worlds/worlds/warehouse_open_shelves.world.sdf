<?xml version="1.0" ?>
<sdf version="1.8">

  <world name="warehouse_open_shelves">

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin name="gz::sim::systems::Physics"
            filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands"
            filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster"
            filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact"
            filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::Sensors"
            filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.81</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <ambient>0.34 0.34 0.34 1</ambient>
      <background>0.68 0.68 0.68 1</background>
      <shadows>true</shadows>
    </scene>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>12 12</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>12 12</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.73 0.73 0.72 1</ambient>
            <diffuse>0.73 0.73 0.72 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="warehouse_walls">
      <static>true</static>

      <link name="wall_x_pos">
        <pose>6 0 1.8 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.16 12 3.6</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.16 12 3.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.64 0.66 0.69 1.0</ambient>
            <diffuse>0.64 0.66 0.69 1.0</diffuse>
            <specular>0.04 0.04 0.04 1.0</specular>
          </material>
        </visual>
      </link>

      <link name="wall_x_neg">
        <pose>-6 0 1.8 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.16 12 3.6</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.16 12 3.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.64 0.66 0.69 1.0</ambient>
            <diffuse>0.64 0.66 0.69 1.0</diffuse>
            <specular>0.04 0.04 0.04 1.0</specular>
          </material>
        </visual>
      </link>

      <link name="wall_y_pos">
        <pose>0 6 1.8 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>12 0.16 3.6</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>12 0.16 3.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.64 0.66 0.69 1.0</ambient>
            <diffuse>0.64 0.66 0.69 1.0</diffuse>
            <specular>0.04 0.04 0.04 1.0</specular>
          </material>
        </visual>
      </link>

      <link name="wall_y_neg">
        <pose>0 -6 1.8 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>12 0.16 3.6</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>12 0.16 3.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.64 0.66 0.69 1.0</ambient>
            <diffuse>0.64 0.66 0.69 1.0</diffuse>
            <specular>0.04 0.04 0.04 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="warehouse_investigation_markings">
      <static>true</static>

      <link name="west_north_start_pad">
        <pose>-5.00 2.40 0.003 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.42 0.42 0.003</size>
            </box>
          </geometry>
          <material>
            <ambient>0.08 0.45 0.90 1.0</ambient>
            <diffuse>0.08 0.45 0.90 1.0</diffuse>
          </material>
        </visual>
      </link>

      <link name="west_south_start_pad">
        <pose>-5.00 -3.20 0.003 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.42 0.42 0.003</size>
            </box>
          </geometry>
          <material>
            <ambient>0.08 0.45 0.90 1.0</ambient>
            <diffuse>0.08 0.45 0.90 1.0</diffuse>
