        </visual>
      </link>

      <link name="east_mid_goal_pad">
        <pose>1.00 0.10 0.003 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.42 0.42 0.003</size>
            </box>
          </geometry>
          <material>
            <ambient>0.92 0.40 0.12 1.0</ambient>
            <diffuse>0.92 0.40 0.12 1.0</diffuse>
          </material>
        </visual>
      </link>

      <link name="east_lower_goal_pad">
        <pose>0.65 -2.30 0.003 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.42 0.42 0.003</size>
            </box>
          </geometry>
          <material>
            <ambient>0.92 0.40 0.12 1.0</ambient>
            <diffuse>0.92 0.40 0.12 1.0</diffuse>
          </material>
        </visual>
      </link>

      <link name="peek_goal_pad">
        <pose>-0.20 -1.45 0.003 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.42 0.42 0.003</size>
            </box>
          </geometry>
          <material>
            <ambient>0.92 0.40 0.12 1.0</ambient>
            <diffuse>0.92 0.40 0.12 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Segmented shelving with open vertical slots and ground-level gaps.
         The lower stock blocks and upper rails create partial occlusion rather
         than the single hard shadow from the original rack. -->
    <model name="warehouse_rack_occluders">
      <static>true</static>

      <link name="north_upright_sw">
        <pose>-2.42 1.10 1.10 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.04</radius><length>2.20</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.04</radius><length>2.20</length></cylinder></geometry><material><ambient>0.18 0.18 0.18 1.0</ambient><diffuse>0.18 0.18 0.18 1.0</diffuse></material></visual>
      </link>
      <link name="north_upright_se">
        <pose>-1.98 1.10 1.10 0 0 0</pose>
