        <collision name="collision"><geometry><box><size>0.36 0.90 1.26</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.36 0.90 1.26</size></box></geometry><material><ambient>0.50 0.55 0.60 1.0</ambient><diffuse>0.50 0.55 0.60 1.0</diffuse></material></visual>
      </link>
