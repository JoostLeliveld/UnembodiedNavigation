<?xml version="1.0" ?>
<sdf version="1.8">
  <!-- Extension-only two-camera warehouse slice.

       This world is intentionally separate from warehouse_aws.world.sdf and the
       locked C1/C2 campaign. It provides camera-A-only, overlap, camera-B-only,
       and camera-A-occluded/camera-B-usable regions for detector, calibration,
       and replay plumbing tests before any thesis claim is made. -->
  <world name="warehouse_multicamera_extension">
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.58 0.58 0.58 1</ambient>
      <background>0.70 0.72 0.74 1</background>
      <shadows>true</shadows>
    </scene>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>12.0 10.5</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>12.0 10.5</size></plane></geometry>
          <material><ambient>0.56 0.55 0.51 1</ambient><diffuse>0.56 0.55 0.51 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="warehouse_walls">
      <static>true</static>
      <link name="wall_south">
        <pose>0 -5.35 2.1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>12.0 0.16 4.2</size></box></geometry></collision>
        <sensor name="contact" type="contact"><contact><collision>collision</collision></contact><update_rate>60</update_rate></sensor>
        <visual name="visual"><geometry><box><size>12.0 0.16 4.2</size></box></geometry><material><ambient>0.62 0.64 0.67 1</ambient><diffuse>0.62 0.64 0.67 1</diffuse></material></visual>
      </link>
      <link name="wall_east">
        <pose>5.85 0 2.1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.16 10.7 4.2</size></box></geometry></collision>
        <sensor name="contact" type="contact"><contact><collision>collision</collision></contact><update_rate>60</update_rate></sensor>
        <visual name="visual"><geometry><box><size>0.16 10.7 4.2</size></box></geometry><material><ambient>0.62 0.64 0.67 1</ambient><diffuse>0.62 0.64 0.67 1</diffuse></material></visual>
      </link>
      <link name="wall_west">
        <pose>-5.85 0 2.1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.16 10.7 4.2</size></box></geometry></collision>
        <sensor name="contact" type="contact"><contact><collision>collision</collision></contact><update_rate>60</update_rate></sensor>
        <visual name="visual"><geometry><box><size>0.16 10.7 4.2</size></box></geometry><material><ambient>0.62 0.64 0.67 1</ambient><diffuse>0.62 0.64 0.67 1</diffuse></material></visual>
      </link>
    </model>

    <model name="extension_occluders">
      <static>true</static>
      <link name="south_blind_stack_for_camera_a">
        <pose>1.55 -1.55 1.15 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.75 1.10 2.30</size></box></geometry></collision>
        <sensor name="contact" type="contact"><contact><collision>collision</collision></contact><update_rate>60</update_rate></sensor>
        <visual name="visual"><geometry><box><size>0.75 1.10 2.30</size></box></geometry><material><ambient>0.70 0.48 0.22 1</ambient><diffuse>0.70 0.48 0.22 1</diffuse></material></visual>
      </link>
      <link name="central_handover_rack">
        <pose>-1.35 1.10 0.80 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.62 2.80 1.60</size></box></geometry></collision>
        <sensor name="contact" type="contact"><contact><collision>collision</collision></contact><update_rate>60</update_rate></sensor>
        <visual name="visual"><geometry><box><size>0.62 2.80 1.60</size></box></geometry><material><ambient>0.93 0.80 0.08 1</ambient><diffuse>0.93 0.80 0.08 1</diffuse></material></visual>
      </link>
      <link name="camera_b_far_side_low_rack">
        <pose>3.30 2.45 0.65 0 0 0</pose>
        <collision name="collision"><geometry><box><size>2.40 0.55 1.30</size></box></geometry></collision>
        <sensor name="contact" type="contact"><contact><collision>collision</collision></contact><update_rate>60</update_rate></sensor>
        <visual name="visual"><geometry><box><size>2.40 0.55 1.30</size></box></geometry><material><ambient>0.93 0.80 0.08 1</ambient><diffuse>0.93 0.80 0.08 1</diffuse></material></visual>
      </link>
    </model>

    <model name="extension_region_markers">
      <static>true</static>
      <link name="camera_a_only_band">
        <pose>-3.6 -3.6 0.018 0 0 0</pose>
        <visual name="visual"><geometry><box><size>2.5 0.06 0.012</size></box></geometry><material><ambient>0.05 0.30 0.85 1</ambient><diffuse>0.05 0.30 0.85 1</diffuse></material></visual>
      </link>
      <link name="overlap_band">
        <pose>0.0 -0.3 0.018 0 0 0</pose>
        <visual name="visual"><geometry><box><size>2.5 0.06 0.012</size></box></geometry><material><ambient>0.05 0.55 0.20 1</ambient><diffuse>0.05 0.55 0.20 1</diffuse></material></visual>
      </link>
      <link name="camera_b_only_band">
        <pose>4.2 1.6 0.018 0 0 0</pose>
        <visual name="visual"><geometry><box><size>2.5 0.06 0.012</size></box></geometry><material><ambient>0.85 0.18 0.18 1</ambient><diffuse>0.85 0.18 0.18 1</diffuse></material></visual>
      </link>
    </model>

    <include>
      <name>external_camera</name>
      <uri>model://external_camera</uri>
      <pose>0.00 -5.50 4.80 0 0.92 1.5708</pose>
    </include>
    <include>
      <name>external_camera_b</name>
      <uri>model://external_camera_b</uri>
      <pose>5.50 0.10 4.80 0 0.92 3.1416</pose>
    </include>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>0.72</intensity>
      <direction>-0.25 0.15 -1</direction>
    </light>
    <light name="extension_overhead_light" type="point">
      <pose>0.0 -0.5 4.2 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>0.62</intensity>
      <attenuation><range>13</range><constant>0.45</constant><linear>0.07</linear><quadratic>0.012</quadratic></attenuation>
    </light>
  </world>
</sdf>
