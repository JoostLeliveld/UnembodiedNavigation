<?xml version="1.0"?>
<sdf version="1.7">
  <world name="parcel_sortation_visibility_cell">

    <atmosphere type="adiabatic"/>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6.0e-6 2.3e-5 -4.2e-5</magnetic_field>

    <physics type="ode" name="default_physics">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <scene><ambient>0.58 0.58 0.58 1</ambient><background>0.70 0.72 0.74 1</background><shadows>true</shadows></scene>

    <!-- ===== Ground ===== -->
    <model name="ground_plane"><static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="visual"><pose>0 -0.25 0 0 0 0</pose><geometry><plane><normal>0 0 1</normal><size>10.0 6.9</size></plane></geometry>
          <material><ambient>0.56 0.55 0.51 1</ambient><diffuse>0.56 0.55 0.51 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
      </link>
    </model>

    <!-- ===== Building walls (5.0 m tall — warehouse ceiling height) =====
         South wall pushed to y=-3.7 so the camera mount at y=-3.5 is inside. -->
    <model name="building_walls"><static>true</static>
      <link name="south_wall"><pose>0.0 -3.70 2.50 0 0 0</pose><collision name="collision"><geometry><box><size>10.00 0.10 5.00</size></box></geometry></collision><visual name="visual"><geometry><box><size>10.00 0.10 5.00</size></box></geometry><material><ambient>0.62 0.64 0.67 1</ambient><diffuse>0.62 0.64 0.67 1</diffuse></material></visual></link>
      <link name="north_wall"><pose>0.0  3.20 2.50 0 0 0</pose><collision name="collision"><geometry><box><size>10.00 0.10 5.00</size></box></geometry></collision><visual name="visual"><geometry><box><size>10.00 0.10 5.00</size></box></geometry><material><ambient>0.62 0.64 0.67 1</ambient><diffuse>0.62 0.64 0.67 1</diffuse></material></visual></link>
      <link name="west_wall"><pose>-4.95 -0.25 2.50 0 0 0</pose><collision name="collision"><geometry><box><size>0.10 6.90 5.00</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.10 6.90 5.00</size></box></geometry><material><ambient>0.62 0.64 0.67 1</ambient><diffuse>0.62 0.64 0.67 1</diffuse></material></visual></link>
      <link name="east_wall"><pose> 4.95 -0.25 2.50 0 0 0</pose><collision name="collision"><geometry><box><size>0.10 6.90 5.00</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.10 6.90 5.00</size></box></geometry><material><ambient>0.62 0.64 0.67 1</ambient><diffuse>0.62 0.64 0.67 1</diffuse></material></visual></link>

      <!-- Dock doors flush against south wall inner face (z bottom=0, top=2.5) -->
      <link name="dock_door_1"><pose>-2.20 -3.64 1.25 0 0 0</pose><visual name="visual"><geometry><box><size>1.80 0.04 2.50</size></box></geometry><material><ambient>0.45 0.48 0.52 1</ambient><diffuse>0.45 0.48 0.52 1</diffuse></material></visual></link>
      <link name="dock_door_2"><pose>0.50 -3.64 1.25 0 0 0</pose><visual name="visual"><geometry><box><size>1.80 0.04 2.50</size></box></geometry><material><ambient>0.45 0.48 0.52 1</ambient><diffuse>0.45 0.48 0.52 1</diffuse></material></visual></link>
      <link name="dock_door_3"><pose>3.20 -3.64 1.25 0 0 0</pose><visual name="visual"><geometry><box><size>1.80 0.04 2.50</size></box></geometry><material><ambient>0.45 0.48 0.52 1</ambient><diffuse>0.45 0.48 0.52 1</diffuse></material></visual></link>

      <!-- Dock door horizontal slats (visual texture) -->
      <link name="dock_door_1_slat"><pose>-2.20 -3.62 0.85 0 0 0</pose><visual name="visual"><geometry><box><size>1.78 0.02 0.04</size></box></geometry><material><ambient>0.32 0.35 0.38 1</ambient><diffuse>0.32 0.35 0.38 1</diffuse></material></visual></link>
      <link name="dock_door_1_slat2"><pose>-2.20 -3.62 1.65 0 0 0</pose><visual name="visual"><geometry><box><size>1.78 0.02 0.04</size></box></geometry><material><ambient>0.32 0.35 0.38 1</ambient><diffuse>0.32 0.35 0.38 1</diffuse></material></visual></link>
      <link name="dock_door_2_slat"><pose>0.50 -3.62 0.85 0 0 0</pose><visual name="visual"><geometry><box><size>1.78 0.02 0.04</size></box></geometry><material><ambient>0.32 0.35 0.38 1</ambient><diffuse>0.32 0.35 0.38 1</diffuse></material></visual></link>
      <link name="dock_door_2_slat2"><pose>0.50 -3.62 1.65 0 0 0</pose><visual name="visual"><geometry><box><size>1.78 0.02 0.04</size></box></geometry><material><ambient>0.32 0.35 0.38 1</ambient><diffuse>0.32 0.35 0.38 1</diffuse></material></visual></link>
      <link name="dock_door_3_slat"><pose>3.20 -3.62 0.85 0 0 0</pose><visual name="visual"><geometry><box><size>1.78 0.02 0.04</size></box></geometry><material><ambient>0.32 0.35 0.38 1</ambient><diffuse>0.32 0.35 0.38 1</diffuse></material></visual></link>
      <link name="dock_door_3_slat2"><pose>3.20 -3.62 1.65 0 0 0</pose><visual name="visual"><geometry><box><size>1.78 0.02 0.04</size></box></geometry><material><ambient>0.32 0.35 0.38 1</ambient><diffuse>0.32 0.35 0.38 1</diffuse></material></visual></link>

      <!-- Dock bumpers at floor along south wall -->
      <link name="dock_bumper_1"><pose>-2.20 -3.60 0.075 0 0 0</pose><visual name="visual"><geometry><box><size>1.80 0.06 0.15</size></box></geometry><material><ambient>0.20 0.20 0.22 1</ambient><diffuse>0.20 0.20 0.22 1</diffuse></material></visual></link>
      <link name="dock_bumper_2"><pose>0.50 -3.60 0.075 0 0 0</pose><visual name="visual"><geometry><box><size>1.80 0.06 0.15</size></box></geometry><material><ambient>0.20 0.20 0.22 1</ambient><diffuse>0.20 0.20 0.22 1</diffuse></material></visual></link>
      <link name="dock_bumper_3"><pose>3.20 -3.60 0.075 0 0 0</pose><visual name="visual"><geometry><box><size>1.80 0.06 0.15</size></box></geometry><material><ambient>0.20 0.20 0.22 1</ambient><diffuse>0.20 0.20 0.22 1</diffuse></material></visual></link>
    </model>

    <!-- ===== Sort wall / rear pallet racks =====
         Three grounded AWS shelf meshes provide the visual warehouse rack
         style. Simple box collisions remain the authoritative no-go layer. -->
    <model name="sort_wall"><static>true</static>
      <link name="sw_collision"><pose>-2.50 2.45 1.15 0 0 0</pose><collision name="collision"><geometry><box><size>2.40 0.50 2.30</size></box></geometry></collision></link>
      <link name="sm_collision"><pose>0.00 2.45 1.15 0 0 0</pose><collision name="collision"><geometry><box><size>2.40 0.50 2.30</size></box></geometry></collision></link>
      <link name="se_collision"><pose>2.50 2.45 1.15 0 0 0</pose><collision name="collision"><geometry><box><size>2.40 0.50 2.30</size></box></geometry></collision></link>

      <link name="aws_shelf_west_visual"><pose>-2.50 2.45 0 0 0 0</pose>
        <visual name="visual"><geometry><mesh>
          <uri>model://aws_robomaker_warehouse_ShelfD_01/meshes/aws_robomaker_warehouse_ShelfD_01_visual.DAE</uri>
          <scale>0.65 0.42 0.88</scale>
        </mesh></geometry></visual></link>
      <link name="aws_shelf_mid_visual"><pose>0.00 2.45 0 0 0 0</pose>
        <visual name="visual"><geometry><mesh>
          <uri>model://aws_robomaker_warehouse_ShelfE_01/meshes/aws_robomaker_warehouse_ShelfE_01_visual.DAE</uri>
          <scale>0.65 0.42 0.88</scale>
        </mesh></geometry></visual></link>
      <link name="aws_shelf_east_visual"><pose>2.50 2.45 0 0 0 0</pose>
        <visual name="visual"><geometry><mesh>
          <uri>model://aws_robomaker_warehouse_ShelfD_01/meshes/aws_robomaker_warehouse_ShelfD_01_visual.DAE</uri>
          <scale>0.65 0.42 0.88</scale>
        </mesh></geometry></visual></link>
    </model>

    <!-- ===== Variable occlusion layer: PEAK condition =====
         Five grounded AWS clutter/parcel meshes in the staging zone. The
         simple box collisions are kept as the known forbidden-zone layer; the
         textured meshes provide the visual 3D occluders. -->
    <model name="peak_occluders"><static>true</static>

      <!-- Known non-driveable staging buffer: a low collision slab matching
           the yellow inbound staging zone. This prevents the robot from
           cutting between parcel stacks while keeping the floor visually
           readable as a controlled forbidden-zone layer. -->
      <link name="staging_buffer_forbidden_zone">
        <pose>-0.10 -0.05 0.025 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>4.40 1.20 0.05</size></box></geometry>
        </collision>
      </link>

      <!-- rear_left: center (-1.45, 0.20), envelope 0.85×0.70×2.10 -->
      <link name="rl_envelope"><pose>-1.45 0.20 1.05 0 0 0</pose><collision name="collision"><geometry><box><size>0.85 0.70 2.10</size></box></geometry></collision></link>
      <link name="rl_aws_clutter_visual"><pose>-1.45 0.20 -0.087 0 0 0.08</pose>
        <visual name="visual"><geometry><mesh>
          <uri>model://aws_robomaker_warehouse_ClutteringA_01/meshes/aws_robomaker_warehouse_ClutteringA_01_visual.DAE</uri>
          <scale>0.40 0.35 1.98</scale>
        </mesh></geometry></visual></link>

      <!-- rear_mid: center (-0.15, 0.20), envelope 0.90×0.70×2.20 -->
      <link name="rm_envelope"><pose>-0.15 0.20 1.10 0 0 0</pose><collision name="collision"><geometry><box><size>0.90 0.70 2.20</size></box></geometry></collision></link>
      <link name="rm_aws_clutter_visual"><pose>-0.15 0.20 -0.091 0 0 -0.06</pose>
        <visual name="visual"><geometry><mesh>
          <uri>model://aws_robomaker_warehouse_ClutteringA_01/meshes/aws_robomaker_warehouse_ClutteringA_01_visual.DAE</uri>
          <scale>0.42 0.35 2.08</scale>
        </mesh></geometry></visual></link>

      <!-- rear_right: center (1.10, 0.20), envelope 0.85×0.70×2.10 -->
      <link name="rr_envelope"><pose>1.10 0.20 1.05 0 0 0</pose><collision name="collision"><geometry><box><size>0.85 0.70 2.10</size></box></geometry></collision></link>
      <link name="rr_aws_clutter_visual"><pose>1.10 0.20 -0.087 0 0 -0.11</pose>
        <visual name="visual"><geometry><mesh>
          <uri>model://aws_robomaker_warehouse_ClutteringA_01/meshes/aws_robomaker_warehouse_ClutteringA_01_visual.DAE</uri>
          <scale>0.40 0.35 1.98</scale>
        </mesh></geometry></visual></link>

      <!-- front_left: center (-0.75, -0.45), envelope 0.90×0.60×2.00 -->
      <link name="fl_envelope"><pose>-0.75 -0.45 1.00 0 0 0</pose><collision name="collision"><geometry><box><size>0.90 0.60 2.00</size></box></geometry></collision></link>
      <link name="fl_aws_clutter_visual"><pose>-0.75 -0.45 -0.083 0 0 0.13</pose>
        <visual name="visual"><geometry><mesh>
          <uri>model://aws_robomaker_warehouse_ClutteringA_01/meshes/aws_robomaker_warehouse_ClutteringA_01_visual.DAE</uri>
          <scale>0.42 0.30 1.89</scale>
        </mesh></geometry></visual></link>

      <!-- front_right: center (0.55, -0.45), envelope 0.90×0.60×2.00 -->
      <link name="fr_envelope"><pose>0.55 -0.45 1.00 0 0 0</pose><collision name="collision"><geometry><box><size>0.90 0.60 2.00</size></box></geometry></collision></link>
      <link name="fr_aws_clutter_visual"><pose>0.55 -0.45 -0.083 0 0 -0.15</pose>
        <visual name="visual"><geometry><mesh>
          <uri>model://aws_robomaker_warehouse_ClutteringA_01/meshes/aws_robomaker_warehouse_ClutteringA_01_visual.DAE</uri>
          <scale>0.42 0.30 1.89</scale>
        </mesh></geometry></visual></link>
    </model>

    <!-- ===== Fixed floor-plan visuals (no collision) ===== -->
    <model name="floor_plan_visuals"><static>true</static>

      <!-- Working room boundary (white) -->
      <link name="boundary_south"><pose>0.00 -3.20 0.003 0 0 0</pose><visual name="visual"><geometry><box><size>9.60 0.04 0.004</size></box></geometry><material><ambient>0.92 0.92 0.94 1</ambient><diffuse>0.92 0.92 0.94 1</diffuse></material></visual></link>
      <link name="boundary_north"><pose>0.00  3.00 0.003 0 0 0</pose><visual name="visual"><geometry><box><size>9.60 0.04 0.004</size></box></geometry><material><ambient>0.92 0.92 0.94 1</ambient><diffuse>0.92 0.92 0.94 1</diffuse></material></visual></link>
      <link name="boundary_west"><pose>-4.80 -0.10 0.003 0 0 0</pose><visual name="visual"><geometry><box><size>0.04 6.20 0.004</size></box></geometry><material><ambient>0.92 0.92 0.94 1</ambient><diffuse>0.92 0.92 0.94 1</diffuse></material></visual></link>
      <link name="boundary_east"><pose> 4.80 -0.10 0.003 0 0 0</pose><visual name="visual"><geometry><box><size>0.04 6.20 0.004</size></box></geometry><material><ambient>0.92 0.92 0.94 1</ambient><diffuse>0.92 0.92 0.94 1</diffuse></material></visual></link>

      <!-- Rear short sortation lane tape -->
      <link name="rear_lane_south"><pose>0.10 0.60 0.005 0 0 0</pose><visual name="visual"><geometry><box><size>7.00 0.05 0.005</size></box></geometry><material><ambient>0.95 0.85 0.10 1</ambient><diffuse>0.95 0.85 0.10 1</diffuse></material></visual></link>
      <link name="rear_lane_north"><pose>0.10 1.40 0.005 0 0 0</pose><visual name="visual"><geometry><box><size>7.00 0.05 0.005</size></box></geometry><material><ambient>0.95 0.85 0.10 1</ambient><diffuse>0.95 0.85 0.10 1</diffuse></material></visual></link>

      <!-- Front long visible lane tape -->
      <link name="front_lane_south"><pose>0.10 -1.70 0.005 0 0 0</pose><visual name="visual"><geometry><box><size>7.00 0.05 0.005</size></box></geometry><material><ambient>0.95 0.85 0.10 1</ambient><diffuse>0.95 0.85 0.10 1</diffuse></material></visual></link>
      <link name="front_lane_north"><pose>0.10 -0.80 0.005 0 0 0</pose><visual name="visual"><geometry><box><size>7.00 0.05 0.005</size></box></geometry><material><ambient>0.95 0.85 0.10 1</ambient><diffuse>0.95 0.85 0.10 1</diffuse></material></visual></link>

      <!-- Inbound Overflow Staging Zone outline (yellow tape) -->
      <link name="staging_pad_south"><pose>-0.10 -0.65 0.005 0 0 0</pose><visual name="visual"><geometry><box><size>4.40 0.06 0.005</size></box></geometry><material><ambient>0.95 0.85 0.10 1</ambient><diffuse>0.95 0.85 0.10 1</diffuse></material></visual></link>
      <link name="staging_pad_north"><pose>-0.10  0.55 0.005 0 0 0</pose><visual name="visual"><geometry><box><size>4.40 0.06 0.005</size></box></geometry><material><ambient>0.95 0.85 0.10 1</ambient><diffuse>0.95 0.85 0.10 1</diffuse></material></visual></link>
      <link name="staging_pad_west"><pose>-2.30 -0.05 0.005 0 0 0</pose><visual name="visual"><geometry><box><size>0.06 1.20 0.005</size></box></geometry><material><ambient>0.95 0.85 0.10 1</ambient><diffuse>0.95 0.85 0.10 1</diffuse></material></visual></link>
      <link name="staging_pad_east"><pose> 2.10 -0.05 0.005 0 0 0</pose><visual name="visual"><geometry><box><size>0.06 1.20 0.005</size></box></geometry><material><ambient>0.95 0.85 0.10 1</ambient><diffuse>0.95 0.85 0.10 1</diffuse></material></visual></link>

      <!-- A: induction pickup bay -->
      <link name="pickup_bay_A"><pose>-3.40 1.00 0.032 0 0 0</pose>
        <visual name="visual"><transparency>0.32</transparency>
          <geometry><box><size>0.75 0.75 0.014</size></box></geometry>
          <material><ambient>0.20 0.85 0.30 1</ambient><diffuse>0.20 0.85 0.30 1</diffuse></material></visual></link>

      <!-- B: sort-wall drop-off bay -->
      <link name="dropoff_bay_B"><pose>3.60 1.00 0.032 0 0 0</pose>
        <visual name="visual"><transparency>0.32</transparency>
          <geometry><box><size>0.75 0.75 0.014</size></box></geometry>
          <material><ambient>0.20 0.85 0.30 1</ambient><diffuse>0.20 0.85 0.30 1</diffuse></material></visual></link>
    </model>

    <!-- ===== A: Induction station =====
         Roller conveyor + connected scanner gantry + loading stand. All
         geometry attached to floor or to other geometry — no floating parts. -->
    <model name="induction_station"><static>true</static>

      <!-- Roller conveyor along west edge of station (N-S oriented) -->
      <link name="conveyor_frame"><pose>-4.55 1.00 0.40 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.55 1.40 0.80</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.55 1.40 0.80</size></box></geometry>
          <material><ambient>0.55 0.57 0.60 1</ambient><diffuse>0.55 0.57 0.60 1</diffuse></material></visual></link>
      <link name="conveyor_belt"><pose>-4.55 1.00 0.815 0 0 0</pose>
        <visual name="visual"><geometry><box><size>0.50 1.36 0.030</size></box></geometry>
          <material><ambient>0.14 0.14 0.16 1</ambient><diffuse>0.14 0.14 0.16 1</diffuse></material></visual></link>

      <!-- Loading stand (table) east of conveyor, west of pickup bay -->
      <link name="loading_stand"><pose>-4.15 1.00 0.40 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.50 0.65 0.80</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.50 0.65 0.80</size></box></geometry>
          <material><ambient>0.50 0.52 0.55 1</ambient><diffuse>0.50 0.52 0.55 1</diffuse></material></visual></link>

      <!-- Scanner gantry: single column from floor to z=2.50 with scanner
           head box sitting on top. No floating parts. -->
      <link name="gantry_column"><pose>-4.15 0.55 1.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.06 0.06 2.50</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.06 0.06 2.50</size></box></geometry>
          <material><ambient>0.28 0.30 0.34 1</ambient><diffuse>0.28 0.30 0.34 1</diffuse></material></visual></link>
      <link name="gantry_horizontal"><pose>-4.15 0.78 2.46 0 0 0</pose>
        <visual name="visual"><geometry><box><size>0.06 0.50 0.06</size></box></geometry>
          <material><ambient>0.28 0.30 0.34 1</ambient><diffuse>0.28 0.30 0.34 1</diffuse></material></visual></link>
      <link name="scanner_head_drop"><pose>-4.15 1.00 2.30 0 0 0</pose>
        <visual name="visual"><geometry><box><size>0.04 0.04 0.30</size></box></geometry>
          <material><ambient>0.28 0.30 0.34 1</ambient><diffuse>0.28 0.30 0.34 1</diffuse></material></visual></link>
      <link name="scanner_head"><pose>-4.15 1.00 2.09 0 0 0</pose>
        <visual name="visual"><geometry><box><size>0.16 0.20 0.12</size></box></geometry>
          <material><ambient>0.08 0.09 0.10 1</ambient><diffuse>0.08 0.09 0.10 1</diffuse></material></visual></link>

      <!-- Sign panel mounted on the gantry column (faces working area) -->
      <link name="induction_sign"><pose>-4.10 0.55 2.20 0 0 0</pose>
        <visual name="visual"><geometry><box><size>0.04 0.50 0.30</size></box></geometry>
          <material><ambient>0.96 0.96 0.94 1</ambient><diffuse>0.96 0.96 0.94 1</diffuse></material></visual></link>
      <link name="induction_sign_stripe"><pose>-4.075 0.55 2.08 0 0 0</pose>
        <visual name="visual"><geometry><box><size>0.04 0.50 0.08</size></box></geometry>
          <material><ambient>0.20 0.85 0.30 1</ambient><diffuse>0.20 0.85 0.30 1</diffuse></material></visual></link>

      <!-- Tote sitting on loading stand top (stand top = z=0.80, tote h=0.20, center z=0.90) -->
      <link name="ready_tote"><pose>-4.15 1.00 0.90 0 0 0.05</pose>
        <visual name="visual"><geometry><box><size>0.36 0.46 0.20</size></box></geometry>
          <material><ambient>0.78 0.66 0.46 1</ambient><diffuse>0.78 0.66 0.46 1</diffuse></material></visual></link>

      <!-- Parcel on the conveyor belt (belt top z = 0.83, parcel h=0.30, center z=0.98) -->
      <link name="conveyor_parcel"><pose>-4.55 0.40 0.98 0 0 0.03</pose>
        <visual name="visual"><geometry><box><size>0.40 0.32 0.30</size></box></geometry>
          <material><ambient>0.74 0.62 0.42 1</ambient><diffuse>0.74 0.62 0.42 1</diffuse></material></visual></link>
    </model>

    <!-- ===== B: Sort wall drop-off bay =====
         Low handoff buffer, tote on top, sign mounted directly on the rack
         front face (in front of se shelves at y=2.20). -->
    <model name="sortwall_dropoff"><static>true</static>

      <link name="handoff_table"><pose>3.60 1.70 0.40 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.85 0.50 0.80</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.85 0.50 0.80</size></box></geometry>
          <material><ambient>0.50 0.52 0.55 1</ambient><diffuse>0.50 0.52 0.55 1</diffuse></material></visual></link>

      <link name="dropoff_table_tote"><pose>3.60 1.70 0.90 0 0 -0.04</pose>
        <visual name="visual"><geometry><box><size>0.35 0.40 0.20</size></box></geometry>
          <material><ambient>0.78 0.66 0.46 1</ambient><diffuse>0.78 0.66 0.46 1</diffuse></material></visual></link>

      <!-- "Sort Wall C / Dispatch Lane 3" sign attached to se rack front face -->
      <link name="sortwall_c_sign"><pose>3.60 2.19 1.90 0 0 0</pose>
        <visual name="visual"><geometry><box><size>0.90 0.02 0.32</size></box></geometry>
          <material><ambient>0.96 0.96 0.94 1</ambient><diffuse>0.96 0.96 0.94 1</diffuse></material></visual></link>
      <link name="sortwall_c_stripe"><pose>3.60 2.175 1.78 0 0 0</pose>
        <visual name="visual"><geometry><box><size>0.90 0.02 0.10</size></box></geometry>
          <material><ambient>0.92 0.20 0.18 1</ambient><diffuse>0.92 0.20 0.18 1</diffuse></material></visual></link>
    </model>

    <!-- ===== Receiving / dock context ===== -->
    <model name="receiving_context"><static>true</static>

      <!-- Inbound receiving conveyor along south buffer -->
      <link name="inbound_conveyor_frame"><pose>0.50 -2.95 0.40 0 0 0</pose>
        <collision name="collision"><geometry><box><size>3.20 0.55 0.80</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3.20 0.55 0.80</size></box></geometry>
          <material><ambient>0.55 0.57 0.60 1</ambient><diffuse>0.55 0.57 0.60 1</diffuse></material></visual></link>
      <link name="inbound_conveyor_belt"><pose>0.50 -2.95 0.815 0 0 0</pose>
        <visual name="visual"><geometry><box><size>3.18 0.50 0.030</size></box></geometry>
          <material><ambient>0.14 0.14 0.16 1</ambient><diffuse>0.14 0.14 0.16 1</diffuse></material></visual></link>
      <!-- Parcels riding on belt: belt top z=0.83, parcel h=0.30, center z=0.98 -->
      <link name="inbound_parcel_1"><pose>-0.10 -2.95 0.98 0 0 0.04</pose>
        <visual name="visual"><geometry><box><size>0.40 0.35 0.30</size></box></geometry>
          <material><ambient>0.78 0.66 0.46 1</ambient><diffuse>0.78 0.66 0.46 1</diffuse></material></visual></link>
      <link name="inbound_parcel_2"><pose>0.95 -2.95 0.97 0 0 -0.05</pose>
        <visual name="visual"><geometry><box><size>0.35 0.30 0.28</size></box></geometry>
          <material><ambient>0.74 0.62 0.42 1</ambient><diffuse>0.74 0.62 0.42 1</diffuse></material></visual></link>
      <link name="inbound_parcel_3"><pose>1.65 -2.95 0.99 0 0 0.02</pose>
        <visual name="visual"><geometry><box><size>0.38 0.32 0.32</size></box></geometry>
          <material><ambient>0.80 0.68 0.48 1</ambient><diffuse>0.80 0.68 0.48 1</diffuse></material></visual></link>

      <!-- Pallet jack parked at east end of receiving (out of all lanes) -->
      <link name="east_pallet_jack"><pose>4.30 -2.85 0 0 0 1.5708</pose>
        <visual name="visual"><geometry><mesh>
          <uri>model://aws_robomaker_warehouse_PalletJackB_01/meshes/aws_robomaker_warehouse_PalletJackB_01_visual.DAE</uri>
          <scale>1.0 1.0 1.0</scale>
        </mesh></geometry></visual></link>

      <!-- Trash can near west receiving -->
      <link name="trashcan"><pose>-3.40 -2.95 0 0 0 0</pose>
        <visual name="visual"><geometry><mesh>
          <uri>model://aws_robomaker_warehouse_TrashCanC_01/meshes/aws_robomaker_warehouse_TrashCanC_01_visual.DAE</uri>
          <scale>1.0 1.0 1.0</scale>
        </mesh></geometry></visual></link>

    </model>

    <!-- ===== Mission floor markers (task anchors) ===== -->
    <model name="mission_floor_markers"><static>true</static>
      <link name="A_induction_pickup"><pose>-3.40 1.00 0.055 0 0 0</pose><visual name="visual"><geometry><cylinder><radius>0.16</radius><length>0.018</length></cylinder></geometry><material><ambient>0.02 0.22 0.86 1</ambient><diffuse>0.02 0.22 0.86 1</diffuse></material></visual></link>
      <link name="B_sortwall_dropoff"><pose>3.60 1.00 0.057 0 0 0</pose><visual name="visual"><geometry><cylinder><radius>0.16</radius><length>0.018</length></cylinder></geometry><material><ambient>0.02 0.52 0.22 1</ambient><diffuse>0.02 0.52 0.22 1</diffuse></material></visual></link>
    </model>

    <!-- ===== South overview camera mount =====
         Centered high wall camera for paper-facing visibility figures. The
         sensor is offset into the room so it does not see its own pole or the
         south wall lip. -->
    <model name="camera_mount"><static>true</static>
      <link name="column"><pose>0.00 -3.20 2.34 0 0 0</pose>
        <visual name="visual"><cast_shadows>false</cast_shadows><geometry><box><size>0.10 0.10 4.72</size></box></geometry>
          <material><ambient>0.32 0.34 0.36 1</ambient><diffuse>0.32 0.34 0.36 1</diffuse></material></visual></link>
      <link name="camera_arm"><pose>0.00 -2.98 4.74 0 0 1.5708</pose>
        <visual name="visual"><cast_shadows>false</cast_shadows><geometry><box><size>0.08 0.54 0.04</size></box></geometry>
          <material><ambient>0.42 0.44 0.46 1</ambient><diffuse>0.42 0.44 0.46 1</diffuse></material></visual></link>
    </model>

    <!-- External overview camera (sensor) — south wall, looking north and down
         over the route-choice lanes and central staging occluders. -->
    <include>
      <name>external_camera</name>
      <uri>model://external_camera</uri>
      <pose>0.00 -2.75 4.75 0 0.95 1.5708</pose>
    </include>

  </world>
</sdf>
