<?xml version="1.0" ?>
<sdf version="1.8">
  <!-- Experiment B: AWS-style exploratory warehouse visibility benchmark.

       This world is NOT a replacement for the compact tested benchmark.
       See docs/active_research_state.md and docs/experiment_registry.md before
       treating any AWS run as evidence.

       Contract: 11.0 m x 10.0 m footprint, split rack rows, 0.55 m rack
       width, 0.90 m driveable aisles, open mid cross-aisle, separated
       wall-side staging pads, a green apron drive lane pulled away from the
       camera wall, low crates outside the known driveable boundary, and only
       the R4/A4 lane-side bay carrying a high stack as the main 3D occluder. -->
  <world name="warehouse_aws">
    <physics name="default_physics" type="ode"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor><real_time_update_rate>1000</real_time_update_rate></physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system"><render_engine>ogre2</render_engine></plugin>
    <gravity>0 0 -9.81</gravity><magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field><atmosphere type="adiabatic"/>
    <scene><ambient>0.58 0.58 0.58 1</ambient><background>0.70 0.72 0.74 1</background><shadows>true</shadows></scene>

    <model name="ground_plane"><static>true</static><link name="link">
      <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>11.0 10.0</size></plane></geometry></collision>
      <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>11.0 10.0</size></plane></geometry><material><ambient>0.56 0.55 0.51 1</ambient><diffuse>0.56 0.55 0.51 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
    </link></model>

    <model name="warehouse_walls"><static>true</static>
      <link name="wall_east"><pose>5.5 0 2.125 0 0 0</pose><collision name="collision"><geometry><box><size>0.16 10.16 4.25</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.16 10.16 4.25</size></box></geometry><material><ambient>0.62 0.64 0.67 1</ambient><diffuse>0.62 0.64 0.67 1</diffuse></material></visual></link>
      <link name="wall_west"><pose>-5.5 0 2.125 0 0 0</pose><collision name="collision"><geometry><box><size>0.16 10.16 4.25</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.16 10.16 4.25</size></box></geometry><material><ambient>0.62 0.64 0.67 1</ambient><diffuse>0.62 0.64 0.67 1</diffuse></material></visual></link>
      <link name="wall_north"><pose>0 5.0 2.125 0 0 0</pose><collision name="collision"><geometry><box><size>11.16 0.16 4.25</size></box></geometry></collision><visual name="visual"><geometry><box><size>11.16 0.16 4.25</size></box></geometry><material><ambient>0.62 0.64 0.67 1</ambient><diffuse>0.62 0.64 0.67 1</diffuse></material></visual></link>
      <link name="wall_south"><pose>0 -5.0 2.125 0 0 0</pose><collision name="collision"><geometry><box><size>11.16 0.16 4.25</size></box></geometry></collision><visual name="visual"><geometry><box><size>11.16 0.16 4.25</size></box></geometry><material><ambient>0.62 0.64 0.67 1</ambient><diffuse>0.62 0.64 0.67 1</diffuse></material></visual></link>
      <link name="dock_left"><pose>-4.3 -5.09 0.075 0 0 0</pose><visual name="visual"><geometry><box><size>0.65 0.055 0.15</size></box></geometry><material><ambient>0.50 0.50 0.50 1</ambient><diffuse>0.50 0.50 0.50 1</diffuse></material></visual></link>
      <link name="dock_receiving"><pose>-0.25 -5.09 0.075 0 0 0</pose><visual name="visual"><geometry><box><size>0.65 0.055 0.15</size></box></geometry><material><ambient>0.50 0.50 0.50 1</ambient><diffuse>0.50 0.50 0.50 1</diffuse></material></visual></link>
      <link name="dock_shipping_a"><pose>2.7 -5.09 0.075 0 0 0</pose><visual name="visual"><geometry><box><size>0.65 0.055 0.15</size></box></geometry><material><ambient>0.50 0.50 0.50 1</ambient><diffuse>0.50 0.50 0.50 1</diffuse></material></visual></link>
      <link name="dock_shipping_b"><pose>3.6 -5.09 0.075 0 0 0</pose><visual name="visual"><geometry><box><size>0.65 0.055 0.15</size></box></geometry><material><ambient>0.50 0.50 0.50 1</ambient><diffuse>0.50 0.50 0.50 1</diffuse></material></visual></link>
    </model>

