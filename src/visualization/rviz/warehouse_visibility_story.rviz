Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Visibility Map1
        - /Opacity Conservative Map1
        - /Opacity Mean Map1
        - /Plan Preview1
        - /Planner Belief1
        - /Measured State1
        - /Goal Marker1
        - /Visibility Logic1
        - /Camera1
      Splitter Ratio: 0.5
    Tree Height: 560
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Goal Pose1
    Name: Tool Properties
    Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.35
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 160
      Enabled: false
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 40
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: false
    - Alpha: 0.9
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: true
      Enabled: true
      Name: Visibility Map
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /visibility_map
      Update Topic: false
      Use Timestamp: false
      Value: true
    - Alpha: 0.55
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: true
      Enabled: false
      Name: Opacity Conservative Map
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /visibility_opacity_conservative_map
      Update Topic: false
      Use Timestamp: false
      Value: false
    - Alpha: 0.55
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: true
      Enabled: false
      Name: Opacity Mean Map
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /visibility_opacity_mean_map
      Update Topic: false
      Use Timestamp: false
      Value: false
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 166; 0
      Enabled: true
      Head Diameter: 0.3
      Head Length: 0.2
      Length: 0.3
      Line Style: Billboards
      Line Width: 0.08
      Name: Plan Preview
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /plan_preview
      Value: true
    - Alpha: 1
      Axes Length: 0.9
      Axes Radius: 0.08
      Class: rviz_default_plugins/PoseWithCovariance
      Color: 255; 110; 40
      Covariance:
        Orientation:
          Alpha: 0.4
          Color: 255; 225; 80
          Color Style: Unique
          Frame: Local
          Offset: 1
          Scale: 1
          Value: true
        Position:
          Alpha: 0.25
          Color: 255; 170; 0
          Scale: 1
          Value: true
        Value: true
      Enabled: true
      Head Length: 0.3
      Head Radius: 0.1
      Name: Planner Belief
      Shaft Length: 0.8
      Shaft Radius: 0.05
      Shape: Arrow
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /planner_belief
      Value: true
    - Alpha: 0.9
      Axes Length: 0.7
      Axes Radius: 0.06
      Class: rviz_default_plugins/PoseWithCovariance
      Color: 120; 210; 255
      Covariance:
        Orientation:
          Alpha: 0.3
          Color: 150; 210; 255
          Color Style: Unique
          Frame: Local
          Offset: 1
          Scale: 1
          Value: true
        Position:
          Alpha: 0.18
          Color: 120; 210; 255
          Scale: 1
          Value: true
        Value: true
      Enabled: true
      Head Length: 0.22
      Head Radius: 0.08
      Name: Measured State
      Shaft Length: 0.6
      Shaft Radius: 0.04
      Shape: Arrow
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /state/bev
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Goal Marker
      Namespaces:
        goal: true
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_marker
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Visibility Logic
      Namespaces:
        visibility_logic: true
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /visibility_logic_markers
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Camera
      Max Value: 1
      Median window: 5
      Min Value: 0
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /external_camera/image_raw
      Transport Hint: raw
      Value: true
  Enabled: true
  Global Options:
    Background Color: 46; 46; 46
    Fixed Frame: map_bev
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_bev
  Transformation:
    Current: rviz_default_plugins/TF
  Value: true
Views:
  Current:
    Angle: 0
    Class: rviz_default_plugins/TopDownOrtho
    Scale: 14
    Value: TopDownOrtho (rviz_default_plugins)
    X: 0
    Y: 0
Window Geometry:
  Height: 920
  Width: 1500
  X: 30
  Y: 30
